{
  "$schema": "https://outgrowokay.com/tokens-schema/v1",
  "brand": "Outgrow Okay",
  "version": "1.0.0",
  "note": "Accent (#B87D2A) must not be used as body text. Use as decorative/structural element only. On bone ground, use ink text on accent background.",
  "color": {
    "ink":      { "value": "#16130F", "role": "Primary dark ground; primary text on light surfaces" },
    "bone":     { "value": "#F3ECE0", "role": "Cream secondary ground; long-read surface" },
    "accent":   { "value": "#B87D2A", "role": "Ochre/gold — ≤5% of any screen. Never body text. Headline numbers, primary CTA, active states." },
    "grey-100": { "value": "#F0EBE3", "role": "Lightest surface — dashboard cards on bone" },
    "grey-200": { "value": "#DDD5C8", "role": "Borders, dividers" },
    "grey-300": { "value": "#C4BAA9", "role": "Disabled states, placeholder text" },
    "grey-400": { "value": "#A09080", "role": "Muted text on bone" },
    "grey-500": { "value": "#7A6E62", "role": "Secondary text, labels" },
    "grey-600": { "value": "#554D44", "role": "Dark surface text, sidebar on bone" },
    "pos":      { "value": "#4A7C59", "role": "Positive data state (green)" },
    "warn":     { "value": "#A0692A", "role": "Warning data state (amber)" },
    "neg":      { "value": "#C45C5C", "role": "Negative data state (red)" }
  },
  "typography": {
    "families": {
      "heading": "Archivo",
      "body":    "IBM Plex Sans",
      "mono":    "IBM Plex Mono"
    },
    "weights": {
      "light":    300,
      "regular":  400,
      "semibold": 600,
      "bold":     700,
      "black":    900
    },
    "scale": {
      "xs":   "12px",
      "sm":   "14px",
      "base": "16px",
      "md":   "20px",
      "lg":   "28px",
      "xl":   "40px",
      "2xl":  "56px",
      "3xl":  "80px"
    },
    "lineHeight": {
      "tight":  1.2,
      "snug":   1.35,
      "normal": 1.55,
      "mono":   1.4
    },
    "rule": "font-variant-numeric: tabular-nums on all numeric content"
  },
  "spacing": {
    "base": "8px",
    "scale": {
      "1":  "4px",
      "2":  "8px",
      "3":  "12px",
      "4":  "16px",
      "5":  "24px",
      "6":  "32px",
      "7":  "48px",
      "8":  "64px",
      "9":  "96px",
      "10": "128px"
    }
  },
  "layout": {
    "containers": {
      "prose":   "720px",
      "content": "1080px",
      "wide":    "1280px"
    },
    "grid": "Asymmetric: 20% label column + 80% content column on desktop",
    "sidebar": "240px fixed left nav for Studio/dashboard"
  },
  "radius": {
    "sm": "2px",
    "md": "4px",
    "lg": "6px"
  },
  "motion": {
    "easeOut":   "cubic-bezier(0.23, 1, 0.32, 1)",
    "easeInOut": "cubic-bezier(0.77, 0, 0.175, 1)",
    "fast":      "150ms",
    "base":      "200ms",
    "slow":      "300ms",
    "rules": [
      "No decorative animation, no parallax",
      "Entrance: opacity 0→1 + translateY(8px)→0, 200ms ease-out",
      "Button press: scale(0.97), 150ms ease-out",
      "All motion gated behind prefers-reduced-motion: no-preference"
    ]
  }
}
